{
  "name": "@growthos/browser",
  "version": "0.1.1",
  "description": "GrowthOS for websites: campaign attribution, events and identity from the browser, with batching, sendBeacon on page exit and an installation check.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/sdk-browser/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/sdk-browser/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./growthos.js": "./dist/growthos.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@growthos/eslint-config": "workspace:*",
    "esbuild": "^0.21.5",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
