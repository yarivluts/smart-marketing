{
  "name": "@growthos/ad-studio",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "default": "./dist/view.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    }
  },
  "typesVersions": {
    "*": {
      "view": ["dist/view.d.ts"],
      "parse": ["dist/parse.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google-cloud/storage": "^8.2.0",
    "@growthos/firebase-orm-models": "workspace:*",
    "@growthos/shared": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@growthos/eslint-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
