{
  "name": "@growthos/node",
  "version": "0.1.1",
  "description": "Send events, entities and measures to GrowthOS from Node.js - batching, retries, per-record results, a browser relay and an installation check.",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./relay": {
      "import": {
        "types": "./dist/esm/relay.d.ts",
        "default": "./dist/esm/relay.js"
      },
      "require": {
        "types": "./dist/cjs/relay.d.ts",
        "default": "./dist/cjs/relay.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "relay": [
        "./dist/cjs/relay.d.ts"
      ]
    }
  },
  "bin": {
    "growthos": "./dist/cjs/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module' }))\"",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.cjs.json"
  },
  "devDependencies": {
    "@growthos/eslint-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
